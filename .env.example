# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=umarweb.pythonanywhere.com

# Email notifications for the contact form and new reviews.
# Gmail: Google Account > Security > 2-Step Verification > App passwords.
# Leave these empty and emails are only printed in the terminal.
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-letter-app-password
# Optional: where notifications go (defaults to EMAIL_HOST_USER)
NOTIFY_EMAILS=
